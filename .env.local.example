# Railway Postgres — public proxy URL (works from local + Vercel)
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:PORT/railway
DATABASE_URL_DIRECT=postgresql://postgres:password@host.proxy.rlwy.net:PORT/railway

# Inbound + outbound CRM webhook HMAC secret (any high-entropy string)
CRM_WEBHOOK_SECRET=replace-with-64-hex-chars

# Outbound CRM endpoint. Leave blank to simulate + log the submission.
CRM_OUTBOUND_URL=

# Operator console password
OPERATOR_PASSWORD=change-me

# Absolute base URL (canonical / hreflang / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Zellige
